{%- comment -%}
  Ring Builder 3D — product-page section (iJewel-style).

  Replaces the product gallery with the live 3D builder in an iframe and wires
  the store's native Metal + Carat variant selectors to the 3D view, plus a
  native add-to-cart that carries the in-iframe choices (prong, band, shank,
  ring size, engraving) as line-item properties.

  REQUIREMENTS
  - Product must have exactly two options named "Metal" and "Carat"
    (this is what generate-shopify-csv.js produces).
  - Assign this section to the product template for the 3 ring products
    (Oval / Princess / Radiant) via the theme editor, or add it to
    templates/product.ring.json.

  SETTINGS (theme editor)
  - Builder URL:   the deployed Pages URL (no trailing slash).
  - Shape code:    OV / PR / RA  (auto-detected from the handle if left blank).
{%- endcomment -%}

{%- liquid
  assign builder_url = section.settings.builder_url | default: 'https://ring-builder-6hm-91n.pages.dev'
  assign shape_code = section.settings.shape_code | strip
  if shape_code == blank
    assign h = product.handle
    if h contains 'oval'
      assign shape_code = 'OV'
    elsif h contains 'princess'
      assign shape_code = 'PR'
    elsif h contains 'radiant'
      assign shape_code = 'RA'
    elsif h contains 'round'
      assign shape_code = 'RD'
    elsif h contains 'emerald'
      assign shape_code = 'EM'
    elsif h contains 'marquise'
      assign shape_code = 'MQ'
    elsif h contains 'pear'
      assign shape_code = 'PE'
    endif
  endif
-%}

<div class="rb3d-wrap{% if section.settings.full_width %} rb3d-wrap--full{% endif %}"
     style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">
<div class="rb3d" id="rb3d-{{ section.id }}" data-builder-url="{{ builder_url }}" data-shape="{{ shape_code }}">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
    <linearGradient id="rb3d-gem" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f6fbff"/>
      <stop offset="0.5" stop-color="#dcebfa"/>
      <stop offset="1" stop-color="#bfd6ec"/>
    </linearGradient>
  </defs></svg>
  <div class="rb3d__viewer">
    <iframe
      class="rb3d__iframe"
      id="rb3d-iframe-{{ section.id }}"
      title="3D ring preview"
      allow="xr-spatial-tracking; fullscreen"
      loading="lazy"></iframe>
    <button type="button" class="rb3d__spin is-on" id="rb3d-spin-{{ section.id }}"
            aria-pressed="true" title="Auto-rotate">&#x21bb; Auto-rotate</button>
  </div>

  <div class="rb3d__panel">
    <h1 class="rb3d__title">{{ product.title | escape }}</h1>
    <div class="rb3d__price" id="rb3d-price-{{ section.id }}">{{ product.selected_or_first_available_variant.price | money }}</div>

    {%- form 'product', product, id: 'rb3d-form', class: 'rb3d__form' -%}
      <input type="hidden" name="id" id="rb3d-variant-{{ section.id }}"
             value="{{ product.selected_or_first_available_variant.id }}">
      <input type="hidden" name="quantity" value="1">

      {%- for option in product.options_with_values -%}
        <div class="rb3d__opt" data-option-index="{{ option.position }}">
          <label class="rb3d__opt-label">{{ option.name }}</label>
          <div class="rb3d__opt-values">
            {%- for value in option.values -%}
              <button type="button"
                class="rb3d__chip{% if option.selected_value == value %} is-selected{% endif %}"
                data-option-position="{{ option.position }}"
                data-option-value="{{ value | escape }}">{{ value }}</button>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}

      {%- comment -%} Non-variant options (prong / band / shank) — rendered from
          the catalog the iframe publishes; they drive the 3D and ride to cart. {%- endcomment -%}
      <div id="rb3d-extra-{{ section.id }}" class="rb3d__extra"></div>

      {%- comment -%} Line-item properties filled live from the iframe {%- endcomment -%}
      <div id="rb3d-props-{{ section.id }}"></div>

      <button type="submit" class="rb3d__add" id="rb3d-add-{{ section.id }}">Add to Cart</button>
    {%- endform -%}

    <p class="rb3d__note">Configure prong, band, shank, ring size & engraving in the 3D view.</p>
  </div>
</div>
</div>

<script>
(function () {
  var root = document.getElementById('rb3d-{{ section.id }}');
  if (!root) return;
  var builderUrl = root.dataset.builderUrl;
  var origin = (function () { try { return new URL(builderUrl).origin; } catch (e) { return '*'; } })();
  var shape = root.dataset.shape || '';
  var iframe = document.getElementById('rb3d-iframe-{{ section.id }}');
  var variantInput = document.getElementById('rb3d-variant-{{ section.id }}');
  var priceEl = document.getElementById('rb3d-price-{{ section.id }}');
  var addBtn = document.getElementById('rb3d-add-{{ section.id }}');
  var propsBox = document.getElementById('rb3d-props-{{ section.id }}');
  var titleEl = root.querySelector('.rb3d__title');
  var baseTitle = (titleEl ? titleEl.textContent : '').replace(/^\s*custom\s+/i, '').trim();

  // All variants for this product (option1 = Metal, option2 = Carat).
  var VARIANTS = {{ product.variants | json }};

  // Current selection per option position (1-based).
  var selected = {};
  {%- for option in product.options_with_values -%}
    selected[{{ option.position }}] = {{ option.selected_value | json }};
  {%- endfor -%}

  // "White Gold" -> "whiteGold"  (builder metal preset id)
  function metalToId(label) {
    if (!label) return '';
    var t = label.replace(/\s+/g, '');
    return t.charAt(0).toLowerCase() + t.slice(1);
  }
  function money(cents) {
    try { return (cents / 100).toLocaleString(undefined, { style: 'currency', currency: '{{ cart.currency.iso_code }}' }); }
    catch (e) { return '$' + (cents / 100).toFixed(2); }
  }
  function currentMetalLabel() { return selected[1]; }   // option1 = Metal
  function currentCarat()      { return selected[2]; }   // option2 = Carat

  // Diamond-cut icons (SVG) per shape — faceted, with an icy gem fill.
  function shapeIcon(id) {
    var g = ' fill="url(#rb3d-gem)"';   // gem fill on the outline element only
    var inner = {
      RD: '<circle cx="14" cy="14" r="10.5"' + g + '/><circle cx="14" cy="14" r="5"/>'
        + '<path d="M14 3.5 14 9M14 19 14 24.5M3.5 14 9 14M19 14 24.5 14M6.5 6.5 10.4 10.4M17.6 17.6 21.5 21.5M21.5 6.5 17.6 10.4M10.4 17.6 6.5 21.5"/>',
      OV: '<ellipse cx="14" cy="14" rx="7.5" ry="11"' + g + '/><ellipse cx="14" cy="14" rx="3.5" ry="5.5"/>'
        + '<path d="M14 3 14 8.5M14 19.5 14 25M6.5 14 10.5 14M17.5 14 21.5 14M8 7 10.7 9.6M19.9 18.4 17.3 16M19.9 9.6 17.3 12M8 21 10.7 18.4"/>',
      PR: '<rect x="4.5" y="4.5" width="19" height="19"' + g + '/><rect x="9.5" y="9.5" width="9" height="9"/>'
        + '<path d="M4.5 4.5 9.5 9.5M23.5 4.5 18.5 9.5M23.5 23.5 18.5 18.5M4.5 23.5 9.5 18.5"/>',
      EM: '<polygon points="9,3.5 19,3.5 24.5,9 24.5,19 19,24.5 9,24.5 3.5,19 3.5,9"' + g + '/>'
        + '<polygon points="11,7.5 17,7.5 20.5,11 20.5,17 17,20.5 11,20.5 7.5,17 7.5,11"/>'
        + '<path d="M9 3.5 11 7.5M19 3.5 17 7.5M24.5 9 20.5 11M24.5 19 20.5 17M19 24.5 17 20.5M9 24.5 11 20.5M3.5 19 7.5 17M3.5 9 7.5 11"/>',
      MQ: '<path d="M14 2.5C19 8 19 20 14 25.5 9 20 9 8 14 2.5Z"' + g + '/><path d="M6.8 14 21.2 14M14 2.5 14 25.5M9.5 8.5 18.5 8.5M9.5 19.5 18.5 19.5"/>',
      PE: '<path d="M14 3C18.5 9.5 21 14 21 17.5a7 7 0 0 1-14 0C7 14 9.5 9.5 14 3Z"' + g + '/><circle cx="14" cy="17.5" r="4"/><path d="M14 3 14 13.5M9 13 19 13"/>',
      RA: '<rect x="4.5" y="4.5" width="19" height="19" rx="4"' + g + '/><rect x="9.5" y="9.5" width="9" height="9" rx="1.5"/>'
        + '<path d="M5.5 5.5 9.5 9.5M22.5 5.5 18.5 9.5M22.5 22.5 18.5 18.5M5.5 22.5 9.5 18.5"/>'
    }[id] || ('<circle cx="14" cy="14" r="10.5"' + g + '/><circle cx="14" cy="14" r="5"/>');
    return '<svg class="rb3d__shapesvg rb3d__shapesvg--gem" viewBox="0 0 28 28" fill="none" stroke="#6f99ba" stroke-width="1.1" stroke-linejoin="round">' + inner + '</svg>';
  }

  function svgIcon(inner) {
    return '<svg class="rb3d__shapesvg" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">' + inner + '</svg>';
  }
  // Prong / setting style icons (by label keyword).
  function prongIcon(label) {
    var l = (label || '').toLowerCase();
    if (l.indexOf('double') >= 0 && l.indexOf('halo') >= 0) return svgIcon('<circle cx="14" cy="14" r="3.5"/><circle cx="14" cy="14" r="6.5"/><circle cx="14" cy="14" r="9.5"/>');
    if (l.indexOf('hidden') >= 0) return svgIcon('<circle cx="14" cy="12" r="5"/><path d="M8.5 16.5a5.5 5.5 0 0 0 11 0"/>');
    if (l.indexOf('halo') >= 0) return svgIcon('<circle cx="14" cy="14" r="4"/><circle cx="14" cy="14" r="8.5"/>');
    if (l.indexOf('6') >= 0) return svgIcon('<polygon points="14,5 20.5,9 20.5,17 14,21 7.5,17 7.5,9"/><circle cx="14" cy="13" r="4"/>');
    if (l.indexOf('shared') >= 0) return svgIcon('<circle cx="7.5" cy="14" r="3"/><circle cx="14" cy="14" r="4.5"/><circle cx="20.5" cy="14" r="3"/>');
    return svgIcon('<rect x="7.5" y="6.5" width="13" height="13" rx="1.5"/><circle cx="14" cy="13" r="4.5"/>'); // 4-prong / default
  }
  // Band / shank style icons (shared — same style names).
  function styleIcon(label) {
    var l = (label || '').toLowerCase();
    if (l.indexOf('none') >= 0) return svgIcon('<path d="M5 14h18" stroke-dasharray="3 3"/>');
    if (l.indexOf('twist') >= 0) return svgIcon('<path d="M4 10c6 0 6 8 12 8s6-8 12-8"/><path d="M4 18c6 0 6-8 12-8s6 8 12 8"/>');
    if (l.indexOf('split') >= 0) return svgIcon('<path d="M4 14h7"/><path d="M11 14c7 0 6-5 13-5"/><path d="M11 14c7 0 6 5 13 5"/>');
    if (l.indexOf('caviar') >= 0) return svgIcon('<circle cx="6" cy="14" r="1.7"/><circle cx="11.3" cy="14" r="1.7"/><circle cx="16.6" cy="14" r="1.7"/><circle cx="21.9" cy="14" r="1.7"/>');
    if (l.indexOf('knife') >= 0) return svgIcon('<path d="M4 18 14 9 24 18"/><path d="M4 18h20"/>');
    if (l.indexOf('wide') >= 0) return svgIcon('<rect x="4" y="9" width="20" height="10" rx="3"/>');
    return svgIcon('<rect x="4" y="11.5" width="20" height="5" rx="2.5"/>'); // plain / default
  }

  function matchVariant() {
    for (var i = 0; i < VARIANTS.length; i++) {
      var v = VARIANTS[i];
      if (v.option1 === selected[1] && String(v.option2) === String(selected[2])) return v;
    }
    return null;
  }

  function syncVariant() {
    var v = matchVariant();
    if (v) {
      variantInput.value = v.id;
      priceEl.textContent = money(v.price);
      addBtn.disabled = !v.available;
      addBtn.textContent = v.available ? 'Add to Cart' : 'Unavailable';
    }
    updateTitle();
  }

  // Reflect the live selection (metal + carat) in the product title.
  function updateTitle() {
    if (!titleEl) return;
    var m = currentMetalLabel() || '';
    var c = currentCarat() || '';
    var caratTxt = c ? (parseFloat(c) + 'ct ') : '';
    titleEl.textContent = (m ? m + ' ' : '') + caratTxt + baseTitle;
  }

  // Tell the 3D iframe to update metal / carat.
  function postToBuilder(key, value) {
    if (!iframe.contentWindow) return;
    iframe.contentWindow.postMessage({ type: 'rb:setOption', key: key, value: value }, origin);
  }

  // Chip clicks → update selection, variant, and the 3D view.
  root.querySelectorAll('.rb3d__chip').forEach(function (chip) {
    chip.addEventListener('click', function () {
      var pos = chip.dataset.optionPosition;
      var val = chip.dataset.optionValue;
      selected[pos] = val;
      root.querySelectorAll('.rb3d__chip[data-option-position="' + pos + '"]').forEach(function (c) {
        c.classList.toggle('is-selected', c === chip);
      });
      syncVariant();
      if (pos === '1') postToBuilder('metal', metalToId(val));
      else if (pos === '2') postToBuilder('size', String(val));  // builder state key is "size"
    });
  });

  // Line-item properties chosen inside the iframe (prong/band/shank/size/engraving).
  function setProp(name, value) {
    var id = 'rb3d-prop-' + name.replace(/[^a-z0-9]/gi, '');
    var el = document.getElementById(id);
    if (!value) { if (el) el.remove(); return; }
    if (!el) {
      el = document.createElement('input');
      el.type = 'hidden';
      el.id = id;
      el.name = 'properties[' + name + ']';
      propsBox.appendChild(el);
    }
    el.value = value;
  }

  var extraBox = document.getElementById('rb3d-extra-{{ section.id }}');
  var extraSelected = {};   // key -> chosen id (prong/band/shank/fingerSize)

  // Build a chip group for a non-variant option and wire it to the 3D.
  function renderChipGroup(label, key, items, currentId, iconFn) {
    if (!items || !items.length) return;
    var wrap = document.createElement('div');
    wrap.className = 'rb3d__opt';
    var lab = document.createElement('label');
    lab.className = 'rb3d__opt-label';
    lab.textContent = label;
    wrap.appendChild(lab);
    var vals = document.createElement('div');
    vals.className = 'rb3d__opt-values' + (iconFn ? ' rb3d__opt-values--icons' : '');
    items.forEach(function (it) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'rb3d__chip' + (iconFn ? ' rb3d__chip--icon' : '') + (it.id === currentId ? ' is-selected' : '');
      if (iconFn) { b.innerHTML = iconFn(it.label) + '<span class="rb3d__shapelbl">' + it.label + '</span>'; b.setAttribute('title', it.label); }
      else b.textContent = it.label;
      b.addEventListener('click', function () {
        extraSelected[key] = it.id;
        vals.querySelectorAll('.rb3d__chip').forEach(function (c) { c.classList.toggle('is-selected', c === b); });
        postToBuilder(key, it.id);   // 3D rebuilds; iframe echoes config -> properties
      });
      vals.appendChild(b);
    });
    wrap.appendChild(vals);
    extraBox.appendChild(wrap);
  }

  // Center Stone colour swatches — tints the gem(s); on a solitaire that's the
  // centre stone. Posts rb:setOption stoneColor and rides to cart as a property.
  function renderStoneColors() {
    var stones = [
      { label: 'Diamond', hex: '#ffffff' },
      { label: 'Champagne', hex: '#e8d2a6' },
      { label: 'Pink', hex: '#f4c2d0' },
      { label: 'Sapphire', hex: '#2f6fd0' },
      { label: 'Ruby', hex: '#c0304a' },
      { label: 'Emerald', hex: '#2f9e6b' },
      { label: 'Black', hex: '#262626' }
    ];
    var wrap = document.createElement('div'); wrap.className = 'rb3d__opt';
    var lab = document.createElement('label'); lab.className = 'rb3d__opt-label'; lab.textContent = 'Center Stone';
    wrap.appendChild(lab);
    var vals = document.createElement('div'); vals.className = 'rb3d__opt-values rb3d__opt-values--icons';
    stones.forEach(function (s, i) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'rb3d__chip rb3d__chip--swatch' + (i === 0 ? ' is-selected' : '');
      b.setAttribute('title', s.label);
      b.innerHTML = '<span class="rb3d__dot" style="background:' + s.hex + '"></span><span class="rb3d__shapelbl">' + s.label + '</span>';
      b.addEventListener('click', function () {
        vals.querySelectorAll('.rb3d__chip').forEach(function (c) { c.classList.toggle('is-selected', c === b); });
        postToBuilder('stoneColor', s.hex);
        setProp('Center Stone', s.label === 'Diamond' ? '' : s.label);
      });
      vals.appendChild(b);
    });
    wrap.appendChild(vals);
    extraBox.appendChild(wrap);
  }

  function renderExtraOptions(cat, st) {
    if (extraBox.dataset.ready) return;   // render once
    extraBox.dataset.ready = '1';

    // Diamond Shape — each shape is its own Shopify product, so picking another
    // shape navigates to that product (carrying the current metal + carat).
    if (cat.shapes && cat.shapes.length) {
      var sWrap = document.createElement('div');
      sWrap.className = 'rb3d__opt';
      var sLab = document.createElement('label');
      sLab.className = 'rb3d__opt-label';
      sLab.textContent = 'Diamond Shape';
      sWrap.appendChild(sLab);
      var sVals = document.createElement('div');
      sVals.className = 'rb3d__opt-values rb3d__opt-values--icons';
      cat.shapes.forEach(function (sh) {
        var handle = 'custom-' + sh.label.toLowerCase().replace(/\s+/g, '-') + '-diamond-ring';
        var isCurrent = sh.id === shape;
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'rb3d__chip rb3d__chip--shape' + (isCurrent ? ' is-selected' : '');
        b.innerHTML = shapeIcon(sh.id) + '<span class="rb3d__shapelbl">' + sh.label + '</span>';
        b.setAttribute('title', sh.label);
        b.addEventListener('click', function () {
          if (isCurrent) return;
          var q = '?metal=' + encodeURIComponent(metalToId(currentMetalLabel())) +
                  '&carat=' + encodeURIComponent(String(currentCarat()));
          window.location.href = '/products/' + handle + q;
        });
        sVals.appendChild(b);
      });
      sWrap.appendChild(sVals);
      extraBox.appendChild(sWrap);
    }

    renderStoneColors();
    renderChipGroup('Prong', 'prong', cat.prongs, st && st.prong, prongIcon);
    renderChipGroup('Band', 'band', cat.bands, st && st.band, styleIcon);
    renderChipGroup('Shank', 'shank', cat.shanks, st && st.shank, styleIcon);

    // Ring size (finger) — chips of plain string values; key is "fingerSize".
    if (cat.fingerSizes && cat.fingerSizes.length) {
      var items = cat.fingerSizes.map(function (s) { return { id: s, label: s }; });
      renderChipGroup('Ring Size', 'fingerSize', items, st && st.fingerSize);
    }

    // Engraving — free text + font chips.
    var wrap = document.createElement('div');
    wrap.className = 'rb3d__opt';
    var lab = document.createElement('label');
    lab.className = 'rb3d__opt-label';
    lab.textContent = 'Engraving';
    wrap.appendChild(lab);

    var input = document.createElement('input');
    input.type = 'text';
    input.className = 'rb3d__engrave';
    input.maxLength = cat.engravingMax || 20;
    input.placeholder = 'e.g. Forever';
    if (st && st.engraving) input.value = st.engraving;
    var t;
    input.addEventListener('input', function () {
      clearTimeout(t);
      t = setTimeout(function () { postToBuilder('engraving', input.value); }, 250);
    });
    wrap.appendChild(input);

    if (cat.engravingFonts && cat.engravingFonts.length) {
      var fvals = document.createElement('div');
      fvals.className = 'rb3d__opt-values';
      fvals.style.marginTop = '8px';
      cat.engravingFonts.forEach(function (f) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'rb3d__chip' + (st && st.engravingFont === f.id ? ' is-selected' : '');
        b.textContent = f.label;
        b.addEventListener('click', function () {
          fvals.querySelectorAll('.rb3d__chip').forEach(function (c) { c.classList.toggle('is-selected', c === b); });
          postToBuilder('engravingFont', f.id);
        });
        fvals.appendChild(b);
      });
      wrap.appendChild(fvals);
    }
    extraBox.appendChild(wrap);
  }


  window.addEventListener('message', function (e) {
    if (origin !== '*' && e.origin !== origin) return;
    var d = e.data || {};
    if (d.type === 'rb:catalog') { renderExtraOptions(d.catalog || {}, d.state || {}); }
    if (d.type !== 'rb:optionChange' && d.type !== 'rb:config' && d.type !== 'rb:catalog') return;
    var c = d.config; if (!c) return;
    setProp('Prong', c.prong);
    setProp('Band', c.bandStyle);
    setProp('Shank', c.shankStyle);
    setProp('Ring Size', c.ringSize ? ('US ' + c.ringSize) : '');
    setProp('Engraving', c.engraving);
    setProp('Engraving Font', c.engraving ? c.engravingFont : '');
  });

  // If arriving from a shape switch, apply the carried ?metal=&carat=.
  (function applyUrlSelection() {
    var qp = new URLSearchParams(location.search);
    var qMetal = qp.get('metal');   // builder id, e.g. "whiteGold"
    var qCarat = qp.get('carat');
    if (qMetal) {
      for (var i = 0; i < VARIANTS.length; i++) {
        if (metalToId(VARIANTS[i].option1) === qMetal) { selected[1] = VARIANTS[i].option1; break; }
      }
    }
    if (qCarat) {
      for (var j = 0; j < VARIANTS.length; j++) {
        if (String(VARIANTS[j].option2) === String(qCarat)) { selected[2] = VARIANTS[j].option2; break; }
      }
    }
    root.querySelectorAll('.rb3d__chip[data-option-position]').forEach(function (c) {
      c.classList.toggle('is-selected', selected[c.dataset.optionPosition] === c.dataset.optionValue);
    });
  })();

  // Boot the iframe on this product's shape + current variant.
  var src = builderUrl + '/?embed=1&autorotate=1';
  if (shape) src += '&shape=' + encodeURIComponent(shape);
  src += '&metal=' + encodeURIComponent(metalToId(currentMetalLabel()));
  src += '&carat=' + encodeURIComponent(String(currentCarat()));

  // Lazy boot: only load the 3D viewer once it scrolls into view. Each WebGI
  // viewer holds a live WebGL context and browsers cap how many can exist at
  // once (~8-16). Booting on demand - instead of immediately for every product
  // page the shopper clicks through - keeps us under that ceiling and avoids the
  // "WebGL context could not be created / blocked" error on heavy pages.
  var rb3dBooted = false;
  function bootIframe() {
    if (rb3dBooted) return;
    rb3dBooted = true;
    iframe.src = src;
  }

  // Auto-rotate toggle (starts on; pauses automatically while the shopper drags).
  var spinBtn = document.getElementById('rb3d-spin-{{ section.id }}');
  var spinning = true;
  function setSpin(on) {
    spinning = on;
    spinBtn.classList.toggle('is-on', on);
    spinBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
    try { iframe.contentWindow.postMessage({ type: 'rb:autorotate', value: on }, origin); } catch (e) {}
  }
  spinBtn.addEventListener('click', function () { setSpin(!spinning); });

  // Once loaded, re-sync the variant selection and ask for the option catalog
  // (covers any timing race with the builder's initial broadcast).
  iframe.addEventListener('load', function () {
    postToBuilder('metal', metalToId(currentMetalLabel()));
    postToBuilder('size', String(currentCarat()));
    setSpin(spinning);
    try { iframe.contentWindow.postMessage({ type: 'rb:requestCatalog' }, origin); } catch (e) {}
  });

  // Trigger the lazy boot when the viewer nears the viewport. The load handler
  // above is already attached, so it fires correctly whenever the src is set.
  if ('IntersectionObserver' in window) {
    var rb3dObserver = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting) { bootIframe(); rb3dObserver.disconnect(); break; }
      }
    }, { rootMargin: '200px' });
    rb3dObserver.observe(iframe);
  } else {
    bootIframe();
  }

  syncVariant();
})();
</script>

{%- style -%}
  #shopify-section-{{ section.id }} { overflow-x: clip; }
  .rb3d-wrap { box-sizing: border-box; }
  .rb3d-wrap--full { width: 100vw; max-width: 100vw; margin-left: calc(50% - 50vw); padding-left: 0; padding-right: 0; }
  .rb3d {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 430px);
    gap: 48px;
    align-items: stretch;
    max-width: 1480px;
    margin: 0 auto;
  }
  .rb3d__viewer {
    position: relative; width: 100%;
    height: min(82vh, 800px); min-height: 480px;
    background: #f4f4eb;
    border-radius: 16px; overflow: hidden;
    box-shadow: 0 18px 50px rgba(20,20,20,0.08);
  }
  .rb3d__iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; }
  .rb3d__spin {
    position: absolute; bottom: 16px; right: 16px; z-index: 2;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 9px 14px; border: 1px solid rgba(0,0,0,0.12); background: rgba(255,255,255,0.92); color: #555;
    border-radius: 999px; font-size: 0.8rem; font-weight: 600; cursor: pointer; backdrop-filter: blur(6px);
    transition: all 0.15s;
  }
  .rb3d__spin.is-on { background: #111; color: #fff; border-color: #111; }
ok 
  .rb3d__panel { align-self: start; position: sticky; top: 24px; display: flex; flex-direction: column; }
  .rb3d__title { font-size: 1.9rem; line-height: 1.15; margin: 0 0 10px; font-weight: 600; letter-spacing: -0.01em; }
  .rb3d__price { font-size: 1.5rem; font-weight: 700; color: #111; margin: 0 0 26px; padding-bottom: 22px; border-bottom: 1px solid #ececec; }

  .rb3d__opt { margin-bottom: 24px; }
  .rb3d__extra { margin-top: 0; }
  .rb3d__opt-label { display: block; font-size: 0.78rem; font-weight: 700; margin-bottom: 11px; text-transform: uppercase; letter-spacing: 0.6px; color: #555; }
  .rb3d__opt-values { display: flex; flex-wrap: wrap; gap: 9px; }
  /* Icon option groups (shape / prong / band / shank): even, tidy grid */
  .rb3d__opt-values--icons { display: grid; grid-template-columns: repeat(auto-fill, minmax(68px, 1fr)); gap: 8px; }
  .rb3d__chip {
    padding: 10px 16px; border: 1px solid #dcdcdc; background: #fff; color: #222; cursor: pointer;
    border-radius: 999px; font-size: 0.9rem; line-height: 1; transition: border-color 0.15s, background 0.15s, color 0.15s;
  }
  .rb3d__chip:hover { border-color: #111; }
  .rb3d__chip.is-selected { border-color: #111; background: #111; color: #fff; }
  /* Diamond-shape + style chips: icon on top, label under, fill the grid cell */
  .rb3d__chip--shape, .rb3d__chip--icon, .rb3d__chip--swatch {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
    width: 100%; min-width: 0; min-height: 64px; padding: 10px 6px; border-radius: 12px;
  }
  .rb3d__shapesvg { width: 26px; height: 26px; display: block; flex: none; }
  .rb3d__shapesvg--gem { width: 30px; height: 30px; }
  .rb3d__dot { width: 24px; height: 24px; border-radius: 50%; display: block; flex: none; border: 1px solid rgba(0,0,0,0.18); box-shadow: inset 0 -2px 4px rgba(0,0,0,0.18); }
  .rb3d__shapelbl { font-size: 0.7rem; line-height: 1.1; text-align: center; }
  .rb3d__engrave { width: 100%; padding: 12px 14px; border: 1px solid #dcdcdc; border-radius: 8px; font-size: 0.95rem; box-sizing: border-box; }
  .rb3d__engrave:focus { outline: none; border-color: #111; }

  .rb3d__add {
    width: 100%; margin-top: 16px; padding: 18px; border: 0; background: #111; color: #fff;
    font-size: 1.05rem; font-weight: 700; letter-spacing: 0.3px; cursor: pointer; border-radius: 10px; transition: background 0.15s;
  }
  .rb3d__add:hover:not(:disabled) { background: #333; }
  .rb3d__add:disabled { opacity: 0.4; cursor: not-allowed; }
  .rb3d__note { margin-top: 14px; font-size: 0.82rem; color: #777; line-height: 1.4; }

  @media (max-width: 990px) {
    .rb3d { grid-template-columns: 1fr; gap: 28px; }
    .rb3d__panel { position: static; top: auto; }
    .rb3d__viewer { height: 62vh; min-height: 400px; }
  }
  @media (max-width: 749px) {
    .rb3d-wrap--full { padding-left: 0; padding-right: 0; }
    .rb3d { gap: 16px; }
    /* Pin the 3D ring to the top; options scroll underneath it so the shopper
       always sees the ring update live as they change options. */
    .rb3d__viewer {
      position: sticky; top: 0; z-index: 5;
      height: 46vh; min-height: 300px; border-radius: 0 0 14px 14px;
      box-shadow: 0 6px 16px rgba(20,20,20,0.10);
    }
    .rb3d__panel { padding: 4px 14px 24px; }
    .rb3d__title { font-size: 1.4rem; }
    .rb3d__price { font-size: 1.25rem; margin-bottom: 18px; padding-bottom: 16px; }
    /* Blue-Nile-style option cards: even 3-column grid, larger tappable cards */
    .rb3d__opt-values--icons { grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .rb3d__chip--shape, .rb3d__chip--icon { min-height: 90px; padding: 14px 6px; border-radius: 8px; gap: 8px; }
    .rb3d__shapesvg { width: 30px; height: 30px; }
    .rb3d__shapesvg--gem { width: 34px; height: 34px; }
    .rb3d__shapelbl { font-size: 0.76rem; }
    /* Metal/Carat pills a bit bigger for touch */
    .rb3d__chip { padding: 11px 16px; font-size: 0.92rem; }
  }
{%- endstyle -%}

