{{ 'webgi-viewer.css' | asset_url | stylesheet_tag }}

{%- assign model_url = product.metafields.glb.model | default: '' -%}
{%- for media in product.media -%}
  {%- if media.media_type == 'model' -%}
    {%- assign model_url = media.sources[0].url | default: media.url -%}
  {%- endif -%}
{%- endfor -%}

<div id="webgi-viewer-container" style="position:relative;width:100%;height:{{ section.settings.viewer_height }}px;overflow:hidden;background:{{ section.settings.background_color }};border-radius:{{ section.settings.border_radius }}px;{{ section.settings.custom_css }}">
    <div class="topbar" style="display:none;">
        <div class="logo">Jewel<span>3D</span></div>
        <div class="model-name" id="file-name">3D Viewer</div>
    </div>

    <aside class="panel hidden" id="studio-panel">
        <div class="panel-tabs">
            <button class="active" data-tab="materials">Materials</button>
            <button data-tab="scene">Scene</button>
            <button data-tab="settings">Settings</button>
        </div>
        <div class="panel-content">
            <div class="tab-page active" id="tab-materials">
                <div class="section">
                    <div class="section-title">Metal Editor</div>
                    <div class="field">
                        <label>Color <span id="metal-color-value">#d4af37</span></label>
                        <input id="metal-color" type="color" value="#d4af37">
                    </div>
                    <div class="field">
                        <label>Metalness <span id="metalness-value">1.00</span></label>
                        <input id="metalness" type="range" min="0" max="1" step="0.01" value="1">
                    </div>
                    <div class="field">
                        <label>Roughness <span id="metal-roughness-value">0.15</span></label>
                        <input id="metal-roughness" type="range" min="0" max="1" step="0.01" value="0.15">
                    </div>
                </div>
                <div class="section">
                    <div class="section-title">Gemstone Preset</div>
                    <select id="gemstone-preset">
                        <option value="">-- Select --</option>
                        <option value="diamond">Diamond</option>
                        <option value="ruby">Ruby</option>
                        <option value="sapphire_blue">Blue Sapphire</option>
                        <option value="emerald">Emerald</option>
                    </select>
                </div>
                <div class="section">
                    <div class="section-title">Diamond Editor</div>
                    <div class="field">
                        <label>Color <span id="diamond-color-value">#ffffff</span></label>
                        <input id="diamond-color" type="color" value="#ffffff">
                    </div>
                    <div class="field">
                        <label>Dispersion <span id="diamond-dispersion-value">0.0120</span></label>
                        <input id="diamond-dispersion" type="range" min="0" max="0.1" step="0.001" value="0.012">
                    </div>
                    <div class="field">
                        <label>Refractive Index <span id="diamond-refractive-index-value">2.60</span></label>
                        <input id="diamond-refractive-index" type="range" min="1.3" max="3.5" step="0.01" value="2.6">
                    </div>
                    <div class="field">
                        <label>Detected <span id="diamond-mesh-count-value">0</span> diamonds</label>
                    </div>
                </div>
            </div>

            <div class="tab-page" id="tab-scene">
                <div class="section">
                    <div class="section-title">Environment</div>
                    <div class="field">
                        <label>Intensity <span id="hdr-intensity-value">1.00</span></label>
                        <input id="hdr-intensity" type="range" min="0" max="5" step="0.05" value="1">
                    </div>
                </div>
                <div class="section">
                    <div class="section-title">Background</div>
                    <div class="field">
                        <label>Color <span id="bg-color-value">#ffffff</span></label>
                        <input id="bg-color" type="color" value="#ffffff">
                    </div>
                </div>
                <div class="section">
                    <div class="section-title">Alignment</div>
                    <div class="field">
                        <label>Rotate <span id="align-horizontal-value">0°</span></label>
                        <input id="align-horizontal" type="range" min="0" max="360" step="1" value="0">
                    </div>
                    <div class="field">
                        <label>Tilt <span id="align-vertical-value">-2.9°</span></label>
                        <input id="align-vertical" type="range" min="-15" max="15" step="0.1" value="-2.9">
                    </div>
                </div>
            </div>

            <div class="tab-page" id="tab-settings">
                <div class="section">
                    <div class="section-title">Render</div>
                    <div class="field">
                        <label>Exposure <span id="exposure-value">1.00</span></label>
                        <input id="exposure" type="range" min="0.2" max="3" step="0.05" value="1">
                    </div>
                    <div class="field">
                        <label>Contrast <span id="contrast-value">1.10</span></label>
                        <input id="contrast" type="range" min="0.5" max="2" step="0.05" value="1.1">
                    </div>
                </div>
            </div>
        </div>
    </aside>

    <div class="orientation-indicator" id="orientation-indicator">
        <div class="orientation-label">Tilt</div>
        <div class="orientation-ring-wrap">
            <div class="orientation-ring" id="orientation-ring">
                <div class="orientation-dot" id="orientation-dot"></div>
            </div>
        </div>
        <div class="orientation-value" id="orientation-value">0°</div>
        <div class="orientation-status" id="orientation-status">Horizontal</div>
    </div>

    <div class="status-bar" id="setup-status" style="position:fixed;bottom:12px;left:50%;transform:translateX(-50%);z-index:20;background:rgba(255,255,255,0.85);backdrop-filter:blur(8px);padding:6px 16px;border-radius:999px;border:1px solid rgba(74,57,39,0.12);font-size:11px;white-space:nowrap;">Loading...</div>

    <div id="frontend-error" class="error-banner" hidden></div>

    <div class="loader" id="loader">
        <svg width="48" height="48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="24" cy="24" r="20" stroke="#ddd" stroke-width="2" fill="none"/>
            <circle cx="24" cy="24" r="20" stroke="#7f4e17" stroke-width="2" fill="none" stroke-dasharray="31.4 125.6" style="transform-origin:center;animation:spin 1s linear infinite;"/>
        </svg>
        <p>Loading 3D viewer...</p>
    </div>

    <canvas id="webgi-canvas"></canvas>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var container = document.getElementById('webgi-viewer-container');

        var toggleBtn = container.querySelector('#toggle-panel');
        var panel = container.querySelector('#studio-panel');
        if (toggleBtn && panel) {
            toggleBtn.addEventListener('click', function() {
                panel.classList.toggle('hidden');
                toggleBtn.classList.toggle('active');
            });
        }

        container.querySelectorAll('[data-tab]').forEach(function(btn) {
            btn.addEventListener('click', function() {
                container.querySelectorAll('[data-tab]').forEach(function(b) { b.classList.remove('active'); });
                container.querySelectorAll('.tab-page').forEach(function(p) { p.classList.remove('active'); });
                btn.classList.add('active');
                var tab = container.getElementById('tab-' + btn.dataset.tab);
                if (tab) tab.classList.add('active');
            });
        });
    });
</script>

<script>
    window.WEBGI_VIEWER_CONFIG = {
        modelPath: {% if model_url != '' %}'{{ model_url }}'{% else %}'{{ section.settings.model_url | default: "assets/main.glb" | asset_url }}'{% endif %},
        environmentPath: '{{ section.settings.environment_url | default: "assets/env_gem.hdr" | asset_url }}',
        dracoDecoderPath: '{{ "assets/" | asset_url }}',
        backgroundColor: '{{ section.settings.background_color }}',
        initialZoomPercent: {{ section.settings.initial_zoom }},
        metal: {
            color: '{{ section.settings.metal_color }}',
            metalness: {{ section.settings.metal_metalness }},
            roughness: {{ section.settings.metal_roughness }},
            envMapIntensity: {{ section.settings.metal_env_intensity }}
        },
        diamond: {
            color: '{{ section.settings.diamond_color }}',
            transmission: {{ section.settings.diamond_transmission }},
            refractiveIndex: {{ section.settings.diamond_ior }},
            sparkle: {{ section.settings.diamond_sparkle }}
        }
    };
</script>
<script src="{{ 'webgi-viewer.js' | asset_url }}" defer></script>

{% schema %}
{
    "name": "WebGI 3D Viewer",
    "target": "section",
    "settings": [
        {
            "type": "header",
            "content": "Model"
        },
        {
            "type": "text",
            "id": "model_url",
            "label": "Default model URL",
            "info": "Used when the product has no 3D model attached.",
            "default": "assets/main.glb"
        },
        {
            "type": "header",
            "content": "Environment"
        },
        {
            "type": "text",
            "id": "environment_url",
            "label": "HDR Environment URL",
            "default": "assets/env_gem.hdr",
            "info": "Path to .hdr or .exr file for reflections."
        },
        {
            "type": "header",
            "content": "Display"
        },
        {
            "type": "range",
            "id": "viewer_height",
            "label": "Viewer height (px)",
            "default": 500,
            "min": 300,
            "max": 900,
            "step": 10
        },
        {
            "type": "range",
            "id": "border_radius",
            "label": "Corner radius (px)",
            "default": 12,
            "min": 0,
            "max": 40,
            "step": 2
        },
        {
            "type": "color",
            "id": "background_color",
            "label": "Background color",
            "default": "#ffffff"
        },
        {
            "type": "range",
            "id": "initial_zoom",
            "label": "Initial zoom %",
            "default": 60,
            "min": 20,
            "max": 100,
            "step": 5
        },
        {
            "type": "textarea",
            "id": "custom_css",
            "label": "Custom CSS",
            "info": "Extra CSS rules for the viewer container.",
            "default": ""
        },
        {
            "type": "header",
            "content": "Metal Defaults"
        },
        {
            "type": "color",
            "id": "metal_color",
            "label": "Metal color",
            "default": "#d4af37"
        },
        {
            "type": "range",
            "id": "metal_metalness",
            "label": "Metalness",
            "default": 1,
            "min": 0,
            "max": 1,
            "step": 0.05
        },
        {
            "type": "range",
            "id": "metal_roughness",
            "label": "Roughness",
            "default": 0.15,
            "min": 0,
            "max": 1,
            "step": 0.05
        },
        {
            "type": "range",
            "id": "metal_env_intensity",
            "label": "Reflection intensity",
            "default": 2.2,
            "min": 0,
            "max": 5,
            "step": 0.1
        },
        {
            "type": "header",
            "content": "Diamond Defaults"
        },
        {
            "type": "color",
            "id": "diamond_color",
            "label": "Diamond tint",
            "default": "#ffffff"
        },
        {
            "type": "range",
            "id": "diamond_transmission",
            "label": "Transmission",
            "default": 0.95,
            "min": 0,
            "max": 1,
            "step": 0.05
        },
        {
            "type": "range",
            "id": "diamond_ior",
            "label": "Refractive index (IOR)",
            "default": 2.6,
            "min": 1.3,
            "max": 3.5,
            "step": 0.1
        },
        {
            "type": "range",
            "id": "diamond_sparkle",
            "label": "Sparkle / env intensity",
            "default": 2.3,
            "min": 0,
            "max": 8,
            "step": 0.1
        }
    ],
    "presets": [
        {
            "name": "WebGI 3D Viewer",
            "settings": {
                "model_url": "assets/main.glb",
                "environment_url": "assets/env_gem.hdr",
                "viewer_height": 500,
                "background_color": "#ffffff",
                "initial_zoom": 60,
                "metal_color": "#d4af37",
                "metal_metalness": 1,
                "metal_roughness": 0.15,
                "metal_env_intensity": 2.2,
                "diamond_color": "#ffffff",
                "diamond_transmission": 0.95,
                "diamond_ior": 2.6,
                "diamond_sparkle": 2.3
            }
        }
    ]
}
{% endschema %}
